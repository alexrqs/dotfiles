#!/bin/bash

# Auto-list directory stack after cd. Interactive-only: zsh fires chpwd on
# every `cd`, so without this guard it spams `ls`/`gss`/nvm output into
# Claude Code (and any script), breaking tools that parse `cd` results.
# $RICH_SHELL is set in ~/.zshrc. auto-switch-nvmrc itself stays defined
# below; only the on-cd hook is gated.
if [[ -n $RICH_SHELL ]]; then
  chpwd() {
    ls -a
    # dirs -v | head -10
    if git rev-parse --git-dir >/dev/null 2>&1; then
      gss
    fi

# find shorthand
function f() {
  find . -name "$1" 2>&1 | grep -v 'Permission denied'
}

# cd into whatever is the forefront Finder window.
# only mac
cdf() { # short for cdfinder
  cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')"
}

# Copy w/ progress (uses rsync's -P for partial+progress).
#
# Examples:
#   cp_p big.iso ~/Downloads/        # single file → dir
#   cp_p src/ dest/                  # contents of src/ into dest/  (trailing slash matters)
#   cp_p src  dest                   # creates dest/src             (no trailing slash on source)
cp_p() {
  rsync -WavP --human-readable --progress "$1" "$2"
}

# Show useful network info: public IP, local IPs per interface,
# default gateway, DNS resolvers. macOS-only (uses networksetup,
# ipconfig, route, scutil).
ip() {
  echo "🌐 Public IP:"
  dig +short +time=2 +tries=1 myip.opendns.com @resolver1.opendns.com | sed 's/^/  /'

  echo
  echo "🏠 Local IPs:"
  local hw dev addr
  while IFS= read -r line; do
    case "$line" in
    "Hardware Port: "*) hw="${line#Hardware Port: }" ;;
    "Device: "*)
      dev="${line#Device: }"
      addr=$(ipconfig getifaddr "$dev" 2>/dev/null)
      [ -n "$addr" ] && printf "  %-20s %-8s %s\n" "$hw" "$dev" "$addr"
      ;;
    esac
  done < <(networksetup -listallhardwareports)

  echo
  echo "🚪 Gateway:"
  route -n get default 2>/dev/null | awk '/gateway:/ {print "  " $2}'

  echo
  echo "🧭 DNS:"
  scutil --dns | awk '/nameserver\[0\]/ {print $3}' | sort -u | sed 's/^/  /'
}

# direct it all to /dev/null
function nullify() {
  "$@" >/dev/null 2>&1
}

function killport() {
  local pids
  pids=$(lsof -ti ":$1")
  if [ -z "$pids" ]; then
    echo "nothing listening on port $1"
    return 1
  fi
  echo "killing $(echo "$pids" | wc -l | tr -d ' ') process(es) on port $1: $pids"
  echo "$pids" | xargs kill
}

function refresh() {
  bunx rimraf build/ dist/ node_modules/ .next/

  if [[ $1 == 'bun' ]]; then
    bun install
  else
    npm install
  fi
}

# function klogs() {
#   kl --tail 1 $(kgp | grep $1 | awk '{ print $1 }')
# }   # kubectl stack not installed

# Switch node when entering a directory tree whose .nvmrc differs from the
# last one we activated. The walk-up is pure shell (no forks); we only touch
# nvm when the nearest .nvmrc actually changes, so cd'ing around within one
# project costs nothing. nvm itself reads the .nvmrc, so we don't parse it.
function auto-switch-nvmrc() {
  local dir="$PWD" nvmrc=""
  while [ -n "$dir" ]; do
    [ -f "$dir/.nvmrc" ] && { nvmrc="$dir/.nvmrc"; break; }
    dir="${dir%/*}"
  done

  [ "$nvmrc" = "$_CURRENT_NVMRC" ] && return   # same .nvmrc (or still none)
  _CURRENT_NVMRC="$nvmrc"

  if [ -n "$nvmrc" ]; then
    nvm use 2>/dev/null || nvm install
  else
    nvm use default >/dev/null
  fi
}

# function kkl() {
#   local pod
#   pod=$(kubectl get pods --no-headers -o custom-columns=":metadata.name" | fzf --exit-0)
#
