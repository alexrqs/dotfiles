# Ghostty config. Mirrors the kitty setup: a regular monospace primary
# with Symbols Nerd Font Mono as a glyph-fallback for icons.
#
# In ghostty, multiple `font-family` lines cascade — the FIRST line is
# the primary font (used for text), subsequent lines are fallbacks for
# glyphs the primary doesn't have. Earlier this file only had the
# Symbols Nerd Font Mono line, which has no letters/numbers, so text
# rendering was broken (huge inter-character spacing).

font-size = 18

# Extra line height (thickens each cell vertically).
adjust-cell-height = 20%

# Primary monospace font (matches kitty's default on macOS).
font-family = Menlo

# Fallback for Nerd Font icon glyphs (Powerline, Codicons, Devicons, etc.).
font-family = Symbols Nerd Font Mono

# App icon: the Apple ghost emoji, rendered to Ghostty.icns next to this file.
# `custom` reads macos-custom-icon, which defaults to ~/.config/ghostty/Ghostty.icns
# — exactly where the file lands via the symlink, so no absolute path is needed.
# This changes the Dock and app-switcher icon; Finder's is baked into the signed
# bundle and can't be changed at runtime.
macos-icon = custom

# Left Option sends Esc+ instead of composing accented characters, so
# alt-based bindings (word-wise motion, autosuggest-execute) reach zsh.
macos-option-as-alt = true

# Shift+Enter emits Esc+CR. Matches the `bindkey '^[^M' autosuggest-execute`
# binding in .zshrc, and lets TUIs (Claude Code, nvim) tell it from a plain
# Enter — terminals send an identical CR for both by default.
keybind = shift+enter=text:\x1b\r
